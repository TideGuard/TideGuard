/**
 * TideGuard Worker configuration.
 *
 * Placeholder resource IDs let `wrangler deploy` and Deploy to Cloudflare
 * provision KV / Durable Objects automatically.
 */
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tideguard",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.mp3"],
      "fallthrough": true,
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "DEFAULT_QUEUE": "default",
    "MAX_CONCURRENT_USERS": "20",
    "ADMIT_PER_SECOND": "2",
    "TOKEN_TTL_SECONDS": "600",
    "HEARTBEAT_TIMEOUT_SECONDS": "60",
    "QUEUE_TIMEOUT_SECONDS": "1800",
    "ADMISSION_MODE": "queue",
    // Origin proxy (empty ORIGIN_URL = disabled). See docs/protecting-origin.md
    "ORIGIN_URL": "",
    "ORIGIN_PROTECT_ALL": "true",
    "ORIGIN_PATH_PREFIXES": "",
  },
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000001",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUEUE_ROOM",
        "class_name": "QueueRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QueueRoom"],
    },
  ],
}
